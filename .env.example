# 실제 값은 .env 또는 호스팅(Vercel/Railway 등) 환경변수로 설정하세요.

# PostgreSQL 연결 문자열
#   - 로컬(docker compose): postgresql://kolon:kolon@localhost:5432/kolon?schema=public
#   - Vercel + Neon:        Vercel 대시보드의 Storage(Postgres)에서 자동 주입되는 DATABASE_URL 사용
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# 세션 서명 시크릿 — 운영 필수 교체. 생성: openssl rand -hex 32
AUTH_SECRET="generate-a-strong-random-secret-for-production"
