# 로컬 개발용 예시 — 실제 값은 .env 또는 호스팅 환경변수로 설정하세요.

# 데이터베이스 (SQLite 기본값). 운영에서는 영구 경로/Postgres 사용 권장.
#   - 로컬:   file:./dev.db
#   - Docker: file:/app/data/prod.db
#   - Postgres로 전환 시 prisma/schema.prisma 의 provider 를 "postgresql" 로 변경
DATABASE_URL="file:./dev.db"

# 세션 서명 시크릿 — 운영에서는 반드시 무작위 값으로 교체.
#   생성: openssl rand -hex 32
AUTH_SECRET="generate-a-strong-random-secret-for-production"
